{
  "manifest_version": 3,
  "name": "Report Direct Print",
  "version": "3.0.0",
  "description": "Automatically prints report PDFs to your chosen printer without manual steps.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "cookies",
    "notifications"
  ],
  "key": "",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Report Direct Print"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/printer.png",
    "48": "icons/printer.png",
    "128": "icons/printer.png"
  }
}